{
  "_note": "Market Conditions settings. Information only: no strategy reads these tables. All storage is UTC; send times are Europe/London.",
  "dex_chains": ["Solana", "Ethereum", "BSC", "Base", "Arbitrum", "Hyperliquid L1", "Sui", "Tron", "Robinhood Chain"],
  "stablecoin_chains": ["Solana", "Ethereum", "BSC", "Base", "Robinhood Chain"],
  "launchpads": {"pump.fun": "pump.fun", "pumpswap": "pumpswap"},
  "prices": {"SOL": "coingecko:solana", "BTC": "coingecko:bitcoin"},
  "sources": {
    "A": {"name": "DEX volume per chain", "url": "https://api.llama.fi/overview/dexs/{key}?excludeTotalDataChartBreakdown=true", "enabled": true},
    "B": {"name": "Pump.fun bonding-curve volume", "url": "https://api.llama.fi/summary/dexs/{key}?excludeTotalDataChartBreakdown=true", "enabled": true},
    "C": {"name": "PumpSwap volume", "url": "https://api.llama.fi/summary/dexs/{key}?excludeTotalDataChartBreakdown=true", "enabled": true},
    "D": {"name": "Stablecoin supply per chain", "url": "https://stablecoins.llama.fi/stablecoincharts/{key}", "enabled": true},
    "E": {"name": "Current prices", "url": "https://coins.llama.fi/prices/current/{key}", "enabled": true},
    "F": {"name": "Daily price history", "url": "https://coins.llama.fi/chart/{key}?start={start}&span={span}&period=1d", "enabled": true},
    "G": {"name": "Bridge flows", "url": "https://bridges.llama.fi/bridgevolume/{key}?id=all", "enabled": false,
          "note": "Disabled: DefiLlama returns HTTP 402 (paid plan) for bridge volume. Table mc_bridge_flows exists and stays empty."}
  },
  "fetch": {
    "time_utc": "01:30",
    "timeout_s": 60,
    "retries": 3,
    "backoff_s": 5,
    "pause_s": 1.5,
    "revise_days": 14,
    "price_backfill_days": 450,
    "price_max_points_per_request": 500
  },
  "label_threshold_pct": 10.0,
  "schedule_london": {
    "daily": {"time": "08:00"},
    "weekly": {"time": "08:30", "weekday": 0},
    "monthly": {"time": "09:00", "day": 1}
  },
  "send_window_h": 20
}
