# Copy to .env for running on this PC. Never share or commit .env.
# Dashboard login - required whenever the dashboard is reachable beyond this PC (the VPS).
DASHBOARD_PASSWORD=
# Telegram: token from @BotFather and your chat id. Only a start-up notice for now (no signals).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional private Solana RPC (e.g. https://mainnet.helius-rpc.com/?api-key=...). Default: public RPC.
SOLANA_RPC_URL=
